<style>
  body {
    background: <%= embed_background(@interaction_only, assigns[:embed_style]) %>;
  }

  iframe {
    width: 100%;
    height: 100%;
  }

  <%= if @interaction_only, do: embed_css(@embed_style) %>
</style>

<%!-- The Presenter hook drives the deck: it hands #slider to tiny-slider and
animates the message column. An interaction block has neither, so tiny-slider
gets no container and throws on mount. That is not a cosmetic failure: the
exception aborts the hook loop, so every hook after it stays unmounted, which is
why the joining block rendered its QR container empty. Measured in the browser,
not reasoned about. --%>
<div
  id="presenter"
  phx-hook={!@interaction_only && "Presenter"}
  data-max-page={@event.presentation_file.length || 0}
  data-hash={@event.presentation_file.hash}
  data-current-page={@state.position}
  data-embed-active={if @current_embed, do: "true", else: "false"}
>
  <!-- JOIN SCREEN -->
  <div
    :if={!@presenter_embed}
    id="joinScreen"
    class={"#{if @state.join_screen_visible, do: "opacity-100 z-40", else: "opacity-0 pointer-events-none"} h-full w-full flex flex-col justify-center bg-black absolute transition-opacity"}
  >
    <div class="h-full bg-white text-black text-center flex flex-col items-center justify-center">
      <span class="font-semibold mb-10 sm:text-3xl md:text-4xl lg:text-6xl">
        {gettext("Scan to interact in real-time")}
      </span>
      <div
        phx-hook="QRCode"
        data-code={@event.code}
        data-dynamic="true"
        id="qr"
        phx-update="ignore"
        class="rounded-lg mx-auto flex items-center justify-center mb-14"
      >
      </div>
      <span class="font-semibold mb-10 sm:text-3xl md:text-4xl lg:text-6xl">
        {gettext("Or go to %{url} and use the code:", url: @host)}
      </span>
      <span class="font-semibold mb-10 sm:text-5xl md:text-6xl lg:text-8xl">
        #{String.upcase(@event.code)}
      </span>
    </div>
  </div>
  <%!-- JOIN BLOCK FOR AN EMBEDDED SLIDE --%>
  <%!-- The deck belongs to PowerPoint here, so Claper's own joining screen is
  never projected and nobody would know how to answer. This block is that
  screen, reduced to a card, and it is the single place where an embed carries
  the event code on purpose. --%>
  <div
    :if={@interaction_only && @embed_show == "join"}
    class={
      [
        "w-full flex flex-col items-center justify-center gap-3 p-5 text-center",
        if(@embed_style.panel == "on",
          do:
            if(@embed_style.theme == "dark",
              do: "bg-gray-900/95 rounded-2xl",
              else: "bg-white/95 rounded-2xl"
            ),
          else: ""
        ),
        if(@embed_style.shadow == "on", do: "shadow-lg", else: ""),
        if(@embed_style.theme == "dark", do: "text-white", else: "text-gray-900")
      ]
      |> Enum.join(" ")
    }
  >
    <p class="claper-ink text-lg font-bold">{gettext("Scan to interact in real-time")}</p>
    <%!-- A fixed size, not the presenter screen's viewport-relative one: this
    block is sized by the slide that embeds it, not by the browser window. The
    link may ask for a bigger one, which is what the sidebar does when it reads
    the drawing out to put it on a slide as a picture. --%>
    <div
      phx-hook="QRCode"
      data-code={@event.code}
      data-size={@embed_style.qr}
      id="embed-qr"
      phx-update="ignore"
      class="rounded-lg bg-white p-2 flex items-center justify-center"
    >
    </div>
    <p class="claper-ink text-sm">{gettext("Or go to %{url} and use the code:", url: @host)}</p>
    <p class="claper-ink text-3xl font-bold tracking-wide">#{String.upcase(@event.code)}</p>
  </div>

  <%!-- MESSAGES ON AN EMBEDDED SLIDE --%>
  <%!-- Claper's own message column lives beside the deck, which a PowerPoint
  slide does not have, so an embed gets them as a plain list. Only what the
  owner already shows on the projected view, so hiding the chat hides this too. --%>
  <div
    :if={@interaction_only && @embed_show == "messages"}
    class={
      [
        "w-full flex flex-col gap-2 p-4",
        if(@embed_style.panel == "on",
          do:
            if(@embed_style.theme == "dark",
              do: "bg-gray-900/95 rounded-2xl",
              else: "bg-white/95 rounded-2xl"
            ),
          else: ""
        ),
        if(@embed_style.shadow == "on", do: "shadow-lg", else: "")
      ]
      |> Enum.join(" ")
    }
  >
    <p
      :if={!@state.chat_visible}
      class={"text-sm #{if @embed_style.theme == "dark", do: "text-gray-300", else: "text-gray-500"}"}
    >
      {gettext("Messages are hidden for this event.")}
    </p>
    <div
      :for={post <- embed_posts(@state, @posts, @pinned_posts)}
      class={"claper-ink px-3 py-2 #{bar_radius(@embed_style.radius)} #{if @embed_style.theme == "dark", do: "bg-white/10 text-white", else: "bg-gray-100 text-gray-900"}"}
    >
      <p
        :if={post.name}
        class={"claper-ink text-xs font-semibold #{if @embed_style.theme == "dark", do: "text-gray-300", else: "text-gray-500"}"}
      >
        {post.name}
      </p>
      <p class="claper-ink text-base">{post.body}</p>
    </div>
  </div>
  
<!-- POLL -->
  <%!-- The embed leaves a hidden poll out entirely rather than fading it to
  opacity-0. On the projected view the only reader is the logged in owner, so
  hiding is enough. Behind an embed link the markup is readable by anyone who
  holds the link, and poll_visible defaults to false, so the title, the options
  and the running vote counts would ship with every response. --%>
  <%!-- A pinned embed shows its own poll without waiting for poll_visible: putting
  it on a slide IS the release, and the slide is only shown when the presenter
  reaches it. The results stay behind show_results either way. --%>
  <%= if (!@interaction_only || @embed_show == "interaction") && @current_poll &&
           (!@presenter_embed || @state.poll_visible || @pinned_poll_id) do %>
    <div
      id="poll"
      class={
        if @interaction_only,
          do:
            [
              "w-full flex flex-col justify-center p-4",
              if(@embed_style.panel == "on",
                do:
                  if(@embed_style.theme == "dark",
                    do: "bg-gray-900/95 rounded-2xl",
                    else: "bg-white/95 rounded-2xl"
                  ),
                else: ""
              ),
              if(@embed_style.shadow == "on", do: "shadow-lg", else: "")
            ]
            |> Enum.join(" "),
          else:
            "#{if @state.poll_visible, do: "opacity-100", else: "opacity-0 pointer-events-none"} h-full w-full flex flex-col justify-center bg-black/90 absolute z-30 left-1/2 top-1/2 transform -translate-y-1/2 -translate-x-1/2 p-10 transition-opacity"
      }
    >
      <div class={
        if @interaction_only, do: "w-full mx-auto", else: "w-full md:w-1/2 mx-auto h-full"
      }>
        <%!-- On the projected view this sits on a black overlay, so the text is white.
        An embed on someone else's slide has no ground of its own, so the block
        brings a light one and the text turns dark with it. --%>
        <p class={"claper-ink #{if @iframe, do: "text-xl mb-6", else: "text-5xl mb-24"} #{if @interaction_only, do: (if @embed_style.theme == "dark", do: "text-white", else: "text-gray-900"), else: "text-white"} font-bold text-center"}>
          {@current_poll.title}
        </p>

        <%!-- A scale is the same poll drawn as a row rather than a stack: the
        options are ordered, so left to right carries meaning that a list of
        bars throws away, and an average is worth printing underneath. Each
        column grows from the bottom in proportion to its share. --%>
        <div :if={@current_poll.style == "scale"} class="w-full" id="poll-scale">
          <div class="flex items-end gap-2 h-40">
            <div
              :for={opt <- @current_poll.poll_opts}
              class="flex-1 flex flex-col justify-end items-center h-full gap-1"
            >
              <span
                :if={!@presenter_embed || @current_poll.show_results}
                class="claper-ink text-sm font-bold tabular-nums"
              >
                {opt.vote_count}
              </span>
              <div
                style={"height: #{if !@presenter_embed || @current_poll.show_results, do: max(opt.percentage, 2), else: 2}%;"}
                class={"claper-bar bg-primary w-full transition-all #{bar_radius(@embed_style.radius)}"}
              >
              </div>
              <span class="claper-ink text-sm text-center truncate w-full">{opt.content}</span>
            </div>
          </div>

          <p
            :if={
              (!@presenter_embed || @current_poll.show_results) &&
                Claper.Polls.Poll.average(@current_poll)
            }
            class="claper-ink mt-4 text-center text-2xl font-bold tabular-nums"
          >
            {gettext("Average")}: {Claper.Polls.Poll.average(@current_poll)}
          </p>
        </div>

        <%!-- A ranking's result is not how often something was picked but where
        it landed, so the options stand in the order the room put them, with
        their average place beside them. An option nobody ranked keeps its spot
        at the end: missing from the slide would read as a mistake. --%>
        <div :if={@current_poll.style == "ranking"} class="flex flex-col gap-2">
          <div
            :for={{{opt, place}, at} <- Enum.with_index(@poll_ranked, 1)}
            class={"claper-ink flex items-baseline gap-3 px-4 py-2 #{bar_radius(@embed_style.radius)} #{if @interaction_only, do: (if @embed_style.theme == "dark", do: "bg-white/15 text-white", else: "bg-gray-200 text-gray-900"), else: "bg-gray-500 text-white"}"}
          >
            <span class="text-xl font-bold tabular-nums w-8">{at}.</span>
            <span class="flex-1 text-lg font-bold">{opt.content}</span>
            <span
              :if={(!@presenter_embed || @current_poll.show_results) && place}
              class="text-sm tabular-nums opacity-80"
            >
              {gettext("place")} {place}
            </span>
          </div>
        </div>

        <div
          :if={@current_poll.style not in ["scale", "ranking"]}
          class={"#{if @iframe, do: "space-y-5", else: "space-y-8"} flex flex-col"}
        >
          <%= if (length @current_poll.poll_opts) > 0 do %>
            <%= for opt <- @current_poll.poll_opts do %>
              <div class={"claper-ink #{if @iframe, do: "py-1", else: "py-4"} #{if @interaction_only, do: (if @embed_style.theme == "dark", do: "bg-white/15 text-white", else: "bg-gray-200 text-gray-900"), else: "bg-gray-500 text-white"} #{if @interaction_only, do: bar_radius(@embed_style.radius), else: "rounded-3xl"} px-6 flex justify-between items-center relative overflow-hidden"}>
                <%!-- show_results is the owner's choice about other devices,
                and the attendee view honours it for both the bar and the
                numbers. The embed is another device. --%>
                <div
                  style={"width: #{if !@presenter_embed || @current_poll.show_results, do: opt.percentage, else: 0}%;"}
                  class={"claper-bar bg-primary h-full absolute left-0 transition-all #{if @interaction_only, do: bar_radius(@embed_style.radius), else: "rounded-3xl"}"}
                >
                </div>
                <div class="flex space-x-3 z-10 text-left">
                  <span class={"claper-ink #{if @iframe, do: "text-base", else: "text-2xl"} flex-1 font-bold pr-2"}>
                    {opt.content}
                  </span>
                </div>
                <span
                  :if={!@presenter_embed || @current_poll.show_results}
                  class={"claper-ink #{if @iframe, do: "text-base", else: "text-2xl"} z-10 font-bold"}
                >
                  {opt.percentage}% ({opt.vote_count})
                </span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
  <%!-- QUIZ ON AN EMBEDDED SLIDE --%>
  <%!-- Drawn here rather than through ManageableQuizComponent, which marks the
  correct option with bg-green-600 in the markup and only fades the block out.
  On the owner's own screen that is fine. Through an embed link it is the answer
  key, readable while the quiz runs, so this block emits the correct option and
  the counts only once the owner has released the results. --%>
  <div
    :if={@interaction_only && @embed_show == "interaction" && @current_quiz}
    id="embed-quiz"
    class={
      [
        "w-full flex flex-col justify-center p-4",
        if(@embed_style.panel == "on",
          do:
            if(@embed_style.theme == "dark",
              do: "bg-gray-900/95 rounded-2xl",
              else: "bg-white/95 rounded-2xl"
            ),
          else: ""
        ),
        if(@embed_style.shadow == "on", do: "shadow-lg", else: "")
      ]
      |> Enum.join(" ")
    }
  >
    <p class={"claper-ink text-xl mb-6 font-bold text-center #{if @embed_style.theme == "dark", do: "text-white", else: "text-gray-900"}"}>
      {quiz_heading(@current_quiz, @current_question_idx)}
    </p>

    <%!-- The clock, for a quiz that was given a time per question. It counts
    from the moment the presenter moved to the question, not from the moment
    this block loaded: PowerPoint builds the add-ins on a slide well before it
    shows them, so a clock started on load would already be at zero.

    It counts down in the browser rather than through a message a second, which
    would be one message per second per block on the wall. --%>
    <div
      :if={
        @current_quiz.seconds_per_question && @question_started_at && !@current_quiz.show_results
      }
      id={"quiz-clock-#{@current_quiz.id}"}
      phx-hook="Countdown"
      phx-update="ignore"
      data-seconds={@current_quiz.seconds_per_question}
      data-started={@question_started_at}
      class={"claper-ink mb-4 text-center text-2xl font-bold tabular-nums #{if @embed_style.theme == "dark", do: "text-white", else: "text-gray-900"}"}
    >
    </div>

    <%!-- No claper-ink on the option rows: once the results are out, right and
    wrong are told apart by their own colours, and a chosen text colour that
    overrode those would take the answer away with it. --%>
    <div :if={@current_question_idx >= 0} class="space-y-5 flex flex-col">
      <div
        :for={opt <- quiz_opts(@current_quiz, @current_question_idx)}
        class={"py-1 px-6 flex justify-between items-center relative overflow-hidden #{bar_radius(@embed_style.radius)} #{quiz_opt_colours(opt, @current_quiz.show_results, @embed_style.theme)}"}
      >
        <div
          style={"width: #{if @current_quiz.show_results, do: opt.percentage, else: 0}%;"}
          class={"claper-bar bg-primary h-full absolute left-0 transition-all #{bar_radius(@embed_style.radius)}"}
        >
        </div>
        <div class="flex space-x-3 z-10 text-left">
          <span class="text-base flex-1 font-bold pr-2">{opt.content}</span>
        </div>
        <span :if={@current_quiz.show_results} class="text-base z-10 font-bold">
          {opt.percentage}% ({opt.response_count})
        </span>
      </div>
    </div>

    <%!-- Who is winning. A quiz told the room an average and nothing else,
    which is the one number nobody in it is interested in.

    Behind show_results like everything else: while the question is still open
    the board would say who has the right answer, which is the answer. --%>
    <div
      :if={@embed_style.board == "on" && @current_quiz.show_results && @quiz_board != []}
      class="mt-5"
    >
      <p class={"claper-ink text-sm font-bold mb-2 #{if @embed_style.theme == "dark", do: "text-gray-300", else: "text-gray-500"}"}>
        {gettext("Leaderboard")}
      </p>
      <ol class="flex flex-col gap-1">
        <li
          :for={{{name, score, total, _at}, place} <- Enum.with_index(@quiz_board, 1)}
          class={"claper-ink flex items-baseline gap-3 px-3 py-1 #{bar_radius(@embed_style.radius)} #{if @embed_style.theme == "dark", do: "bg-white/10 text-white", else: "bg-gray-100 text-gray-900"}"}
        >
          <span class="text-sm font-bold tabular-nums w-6">{place}.</span>
          <span class="text-base flex-1 truncate">{name}</span>
          <span class="text-base font-bold tabular-nums">{score}/{total}</span>
        </li>
      </ol>
    </div>
  </div>

  <%!-- OPEN QUESTION ON AN EMBEDDED SLIDE --%>
  <%!-- Claper's forms are its open question: named fields answered in free
  text. Nothing drew them on a presentation screen until now, because the deck
  itself carried the wording and the answers were read afterwards. A slide has
  to show both, so this is the question and what the room is writing.

  Newest first and capped, because the room keeps typing while the slide stays
  the same size, and a list that grows past the block would push the question
  itself out of view. --%>
  <div
    :if={@interaction_only && @embed_show == "interaction" && @current_form}
    id="embed-form"
    class={
      [
        "w-full flex flex-col justify-center p-4",
        if(@embed_style.panel == "on",
          do:
            if(@embed_style.theme == "dark",
              do: "bg-gray-900/95 rounded-2xl",
              else: "bg-white/95 rounded-2xl"
            ),
          else: ""
        ),
        if(@embed_style.shadow == "on", do: "shadow-lg", else: "")
      ]
      |> Enum.join(" ")
    }
  >
    <p class={"claper-ink text-xl mb-4 font-bold text-center #{if @embed_style.theme == "dark", do: "text-white", else: "text-gray-900"}"}>
      {@current_form.title}
    </p>

    <p
      :if={@form_answers == []}
      class={"claper-ink text-sm text-center #{if @embed_style.theme == "dark", do: "text-gray-300", else: "text-gray-500"}"}
    >
      {gettext("Waiting for the first answer.")}
    </p>

    <%!-- A cloud, which is what makes an open question worth putting on a wall:
    eleven people writing "tired" become one large "tired" rather than eleven
    identical lines. The list is still there for answers that are sentences. --%>
    <div
      :if={@form_answers != [] && @embed_style.layout == "cloud"}
      class="flex flex-wrap gap-x-4 gap-y-2 items-baseline justify-center"
    >
      <span
        :for={{answer, count} <- Enum.take(@form_cloud, 30)}
        class={"claper-ink #{cloud_class(answer, count, @form_cloud |> List.first() |> elem(1))} #{if @embed_style.theme == "dark", do: "text-white", else: "text-gray-900"}"}
      >
        {answer}
      </span>
    </div>

    <div
      :if={@form_answers != [] && @embed_style.layout == "list"}
      class="flex flex-wrap gap-2 justify-center"
    >
      <span
        :for={answer <- Enum.take(@form_answers, 24)}
        class={"claper-ink px-3 py-1.5 text-base #{bar_radius(@embed_style.radius)} #{if @embed_style.theme == "dark", do: "bg-white/15 text-white", else: "bg-gray-200 text-gray-900"}"}
      >
        {answer}
      </span>
    </div>
  </div>
  
<!-- QUIZ -->
  <%!-- Same reason as the poll above, and it matters more here: with
  show_results false the component renders the question, every option and the
  correct one marked with bg-green-600, all of it only faded out. Through an
  embed link that is the answer key, readable while the quiz runs. --%>
  <%= if !@interaction_only && @current_quiz && (!@presenter_embed || @current_quiz.show_results) do %>
    <.live_component
      module={ClaperWeb.EventLive.ManageableQuizComponent}
      id={"#{@current_quiz.id}-quiz"}
      quiz={@current_quiz}
      iframe={@iframe}
    />
  <% end %>
  <!-- MESSAGES -->
  <div
    :if={!@interaction_only}
    id="slider-wrapper"
    class={"w-full min-h-screen grid #{if (@state.chat_visible && (@event.presentation_file.length || 0) > 0) || (@current_embed && (@event.presentation_file.length || 0) == 0), do: "grid-cols-[1fr_10px_1fr]", else: "grid-cols-[1fr]"} items-center justify-center relative bg-black"}
    phx-hook="Split"
    data-type="column"
    data-gutter=".gutter-1"
  >
    <div
      :if={@state.chat_visible}
      class="px-5 transition-all duration-150 flex flex-col h-screen py-5 justify-end max-h-screen bg-black"
      id="post-list-wrapper"
      phx-update="replace"
    >
      <%= if @state.show_only_pinned == false do %>
        <div id="post-list" phx-update="replace">
          <%= for post <- @posts do %>
            <div class={if post.__meta__.state == :deleted, do: "hidden"} id={"#{post.id}-post"}>
              <div class="px-4 pb-2 pt-3 rounded-b-lg rounded-tr-lg bg-white shadow-md text-black break-word mt-4">
                <%= if post.name do %>
                  <p class={"#{if @iframe, do: "text-base", else: "text-lg"} text-gray-400 font-semibold mb-2 mr-2"}>
                    {post.name}
                  </p>
                <% end %>
                <p class={"#{if @iframe, do: "text-xl", else: "text-3xl"}"}>{post.body}</p>

                <%= if post.like_count > 0 || post.love_count > 0 || post.lol_count > 0 do %>
                  <div class="flex h-6 space-x-2 text-lg text-gray-500 pb-3 items-center mt-5">
                    <div class="flex items-center">
                      <%= if post.like_count > 0 do %>
                        <img
                          src="/images/icons/thumb.svg"
                          class={"#{if @iframe, do: "h-4", else: "h-7"}"}
                        />
                        <span class="ml-1">{post.like_count}</span>
                      <% end %>
                    </div>
                    <div class="flex items-center">
                      <%= if post.love_count > 0 do %>
                        <img
                          src="/images/icons/heart.svg"
                          class={"#{if @iframe, do: "h-4", else: "h-7"}"}
                        />
                        <span class="ml-1">{post.love_count}</span>
                      <% end %>
                    </div>
                    <div class="flex items-center">
                      <%= if post.lol_count > 0 do %>
                        <img
                          src="/images/icons/laugh.svg"
                          class={"#{if @iframe, do: "h-4", else: "h-7"}"}
                        />
                        <span class="ml-1">{post.lol_count}</span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div id="pinned-posts" phx-update="replace">
          <%= for post <- @pinned_posts do %>
            <div class={if post.__meta__.state == :deleted, do: "hidden"} id={"#{post.id}-post"}>
              <div class="px-4 pb-2 pt-3 rounded-b-lg rounded-tr-lg bg-white shadow-md text-black break-word mt-4">
                <%= if post.name do %>
                  <p class={"#{if @iframe, do: "text-base", else: "text-lg"} text-gray-400 font-semibold mb-2 mr-2"}>
                    {post.name}
                  </p>
                <% end %>
                <p class={"#{if @iframe, do: "text-xl", else: "text-3xl"}"}>{post.body}</p>

                <%= if post.like_count > 0 || post.love_count > 0 || post.lol_count > 0 do %>
                  <div class="flex h-6 space-x-2 text-lg text-gray-500 pb-3 items-center mt-5">
                    <div class="flex items-center">
                      <%= if post.like_count > 0 do %>
                        <img
                          src="/images/icons/thumb.svg"
                          class={"#{if @iframe, do: "h-4", else: "h-7"}"}
                        />
                        <span class="ml-1">{post.like_count}</span>
                      <% end %>
                    </div>
                    <div class="flex items-center">
                      <%= if post.love_count > 0 do %>
                        <img
                          src="/images/icons/heart.svg"
                          class={"#{if @iframe, do: "h-4", else: "h-7"}"}
                        />
                        <span class="ml-1">{post.love_count}</span>
                      <% end %>
                    </div>
                    <div class="flex items-center">
                      <%= if post.lol_count > 0 do %>
                        <img
                          src="/images/icons/laugh.svg"
                          class={"#{if @iframe, do: "h-4", else: "h-7"}"}
                        />
                        <span class="ml-1">{post.lol_count}</span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <div
      class={"gutter-1 row-span-full cursor-col-resize col-2 text-center text-sm leading-3 text-white #{if (!@state.chat_visible && (@event.presentation_file.length || 0) > 0) || (!@current_embed && (@event.presentation_file.length || 0) == 0), do: "hidden"}"}
      style="writing-mode: vertical-rl"
    >
      •••
    </div>
    <!-- SLIDES -->
    <div id="slides">
      <%!-- Web content is only released to other devices when the owner ticks
      "Attendees can view the web content on their device", and that box starts
      unticked. An embed link is another device, so it follows the same rule the
      attendee view follows. --%>
      <%= if @current_embed && (!@presenter_embed || @current_embed.attendee_visibility) do %>
        <!-- EMBED -->
        <div id="embed" class="max-h-screen w-full h-screen">
          <.live_component
            id="embed-component"
            module={ClaperWeb.EventLive.EmbedIframeComponent}
            provider={@current_embed.provider}
            content={@current_embed.content}
            title={@current_embed.title}
          />
        </div>
      <% end %>
      <!-- The slider holds every page of the deck so the presenter can move through
    it without a round trip, and hides the others with CSS. That is the owner's
    own screen. An embed is read by an audience that may open the page source,
    so it gets the projected page only, re-rendered when the position changes.
    Slides the presenter has not reached never reach the browser. -->
      <div
        :if={!@presenter_embed}
        class={"#{if @current_embed, do: "hidden", else: ""} text-center"}
        id="slider"
        phx-update="ignore"
      >
        <img
          :for={src <- Presentations.get_slide_urls(@event.presentation_file)}
          src={src}
          class="max-h-screen w-auto!"
        />
      </div>
      <div
        :if={@presenter_embed}
        class={"#{if @current_embed, do: "hidden", else: ""} text-center"}
        id="slide"
      >
        <img
          :if={current_slide_url(@event.presentation_file, @state.position)}
          src={current_slide_url(@event.presentation_file, @state.position)}
          class="max-h-screen w-auto!"
        />
      </div>
    </div>
  </div>
  <div
    :if={!@iframe}
    id="reacts"
    phx-hook="GlobalReacts"
    data-class-name="h-24"
    class="fixed right-5 bottom-5 z-30 w-24 pointer-events-none"
    phx-update="ignore"
  >
  </div>
  
<!-- ONLINE BADGE -->
  <div
    :if={!@iframe && @state.show_attendee_count}
    class="absolute z-20 bottom-5 right-5 px-4 pt-3 pb-1 rounded-md bg-black shadow-md text-white flex-1"
  >
    <div class="inline-flex justify-between items-center text-white text-2xl">
      <img src="/images/icons/online-users.svg" class="h-12 mr-2" />
      <span id="counter" phx-hook="UpdateAttendees" phx-update="ignore">
        {@attendees_nb}
      </span>
    </div>
  </div>
</div>
<!-- TRANSCRIPTION SUBTITLES (outside #presenter to avoid slider re-init on text updates) -->
<div
  id="transcription-subtitles"
  class="fixed z-50 bottom-16 left-1/2 transform -translate-x-1/2 max-w-3xl w-full px-4"
>
  <%!-- "presenter" means the screen in the room, which the speaker controls.
  An embed link leaves the room, so it only carries captions the operator
  already meant for other devices. --%>
  <div
    :if={
      @transcription_config && @transcription_config.enabled &&
        @transcription_config.visibility in if(@presenter_embed,
          do: ["both"],
          else: ["both", "presenter"]
        ) &&
        @transcription_text != ""
    }
    class="bg-black/80 rounded-lg px-6 py-3 text-center"
  >
    <p class={"#{if @iframe, do: "text-lg", else: "text-2xl"} text-white font-medium"}>
      {@transcription_text}
    </p>
  </div>
</div>
